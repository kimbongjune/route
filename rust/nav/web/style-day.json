{
  "version": 8,
  "name": "emap-day",
  "glyphs": "{origin}/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "emap-sig": { "type": "vector", "tiles": ["{origin}/vtiles/sig/{z}/{x}/{y}"], "minzoom": 6, "maxzoom": 12, "attribution": "행정안전부 도로명주소 전자지도" },
    "emap-emd": { "type": "vector", "tiles": ["{origin}/vtiles/emd/{z}/{x}/{y}"], "minzoom": 10, "maxzoom": 14 },
    "emap-rw": { "type": "vector", "tiles": ["{origin}/vtiles/rw/{z}/{x}/{y}"], "minzoom": 14, "maxzoom": 18 },
    "emap-link-z7": { "type": "vector", "tiles": ["{origin}/vtiles/link_z7/{z}/{x}/{y}"], "minzoom": 7, "maxzoom": 9, "attribution": "국토교통부 표준노드링크" },
    "emap-link-low": { "type": "vector", "tiles": ["{origin}/vtiles/link_low/{z}/{x}/{y}"], "minzoom": 10, "maxzoom": 11 },
    "emap-link": { "type": "vector", "tiles": ["{origin}/vtiles/link/{z}/{x}/{y}"], "minzoom": 12, "maxzoom": 18 },
    "emap-buld": { "type": "vector", "tiles": ["{origin}/vtiles/buld/{z}/{x}/{y}"], "minzoom": 14, "maxzoom": 18 },
    "emap-water-low": { "type": "vector", "tiles": ["{origin}/vtiles/water_low/{z}/{x}/{y}"], "minzoom": 6, "maxzoom": 11, "attribution": "국토지리정보원 연속수치지형도" },
    "emap-water": { "type": "vector", "tiles": ["{origin}/vtiles/water/{z}/{x}/{y}"], "minzoom": 12, "maxzoom": 18 },
    "emap-rail": { "type": "vector", "tiles": ["{origin}/vtiles/rail/{z}/{x}/{y}"], "minzoom": 8, "maxzoom": 18, "attribution": "국토지리정보원 국가기본도" },
    "emap-subway": { "type": "vector", "tiles": ["{origin}/vtiles/subway/{z}/{x}/{y}"], "minzoom": 9, "maxzoom": 18, "attribution": "행정안전부 지하철 노선" },
    "emap-station": { "type": "vector", "tiles": ["{origin}/vtiles/station/{z}/{x}/{y}"], "minzoom": 12, "maxzoom": 18, "attribution": "국가철도공단 도시광역철도 역사정보" },
    "emap-forest-low": { "type": "vector", "tiles": ["{origin}/vtiles/forest_low/{z}/{x}/{y}"], "minzoom": 11, "maxzoom": 12, "attribution": "산림청 임상도" },
    "emap-forest": { "type": "vector", "tiles": ["{origin}/vtiles/forest/{z}/{x}/{y}"], "minzoom": 13, "maxzoom": 16 },
    "emap-land-extra": { "type": "vector", "tiles": ["{origin}/vtiles/land_extra/{z}/{x}/{y}"], "minzoom": 6, "maxzoom": 12 },
    "terrain": { "type": "raster-dem", "tiles": ["{origin}/terrain/{z}/{x}/{y}.png"], "encoding": "terrarium", "tileSize": 512, "minzoom": 5, "maxzoom": 10, "attribution": "국토지리정보원 수치표고모델" }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#a9cfec" } },

    { "id": "land-extra-fill", "type": "fill", "source": "emap-land-extra", "source-layer": "v_land_extra",
      "paint": { "fill-color": "#f5f3ee", "fill-outline-color": "#f5f3ee" } },
    { "id": "land-base", "type": "fill", "source": "emap-sig", "source-layer": "v_sig",
      "paint": { "fill-color": "#f5f3ee", "fill-outline-color": "#f5f3ee" } },
    { "id": "emd-fill", "type": "fill", "source": "emap-emd", "source-layer": "v_emd", "minzoom": 10,
      "paint": { "fill-color": "#f5f3ee", "fill-outline-color": "#f5f3ee" } },
    { "id": "forest-low-fill", "type": "fill", "source": "emap-forest-low", "source-layer": "v_forest_low", "minzoom": 11, "maxzoom": 13,
      "paint": { "fill-color": "#d4e8c2", "fill-opacity": 0.9 } },
    { "id": "forest-fill", "type": "fill", "source": "emap-forest", "source-layer": "v_forest", "minzoom": 13,
      "paint": { "fill-color": "#d4e8c2", "fill-opacity": 0.9 } },
    { "id": "hillshade", "type": "hillshade", "source": "terrain", "minzoom": 6,
      "paint": { "hillshade-exaggeration": ["interpolate", ["linear"], ["zoom"], 6, 0.5, 12, 0.35, 16, 0.2],
                 "hillshade-shadow-color": "#6b6150", "hillshade-highlight-color": "#ffffff", "hillshade-accent-color": "#8a7f6a" } },
    { "id": "water-low-fill", "type": "fill", "source": "emap-water-low", "source-layer": "v_water_low", "maxzoom": 12,
      "paint": { "fill-color": "#a9cfec" } },
    { "id": "water-fill", "type": "fill", "source": "emap-water", "source-layer": "v_water", "minzoom": 12,
      "paint": { "fill-color": "#a9cfec" } },
    { "id": "sig-line", "type": "line", "source": "emap-sig", "source-layer": "v_sig", "minzoom": 6, "maxzoom": 13,
      "paint": { "line-color": "#b9b1a3", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.5, 12, 1.2], "line-dasharray": [3, 2] } },

    { "id": "rw-fill", "type": "fill", "source": "emap-rw", "source-layer": "v_rw", "minzoom": 14,
      "paint": { "fill-color": "#ffffff", "fill-opacity": 0.8 } },

    { "id": "rail-low", "type": "line", "source": "emap-rail", "source-layer": "v_rail2", "minzoom": 8, "maxzoom": 12,
      "paint": { "line-color": "#9a9a9a", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 12, 1.5] } },

    { "id": "link-z7-casing", "type": "line", "source": "emap-link-z7", "source-layer": "v_link_z7", "minzoom": 7, "maxzoom": 10,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": ["match", ["get", "rank"], "103", "#c9a440", "#c97b26"],
                 "line-width": ["interpolate", ["linear"], ["zoom"], 7, 1.4, 10, 3] } },
    { "id": "link-z7-fill", "type": "line", "source": "emap-link-z7", "source-layer": "v_link_z7", "minzoom": 7, "maxzoom": 10,
      "layout": { "line-cap": "round", "line-join": "round", "line-sort-key": ["-", 200, ["to-number", ["get", "rank"]]] },
      "paint": { "line-color": ["match", ["get", "rank"], "103", "#ffd25e", "#f6a447"],
                 "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.8, 10, 2] } },
    { "id": "link-low-minor", "type": "line", "source": "emap-link-low", "source-layer": "v_link_low", "minzoom": 10, "maxzoom": 12,
      "filter": ["in", ["get", "rank"], ["literal", ["104", "105", "106"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": ["match", ["get", "rank"], "104", "#fbf1cc", "#ffffff"],
                 "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.8, 11, 1.4] } },
    { "id": "link-low-casing", "type": "line", "source": "emap-link-low", "source-layer": "v_link_low", "minzoom": 10, "maxzoom": 12,
      "filter": ["in", ["get", "rank"], ["literal", ["101", "102", "103"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": ["match", ["get", "rank"], "103", "#c9a440", "#c97b26"],
                 "line-width": ["interpolate", ["linear"], ["zoom"], 10, 3, 11, 3.6] } },
    { "id": "link-low-fill", "type": "line", "source": "emap-link-low", "source-layer": "v_link_low", "minzoom": 10, "maxzoom": 12,
      "filter": ["in", ["get", "rank"], ["literal", ["101", "102", "103"]]],
      "layout": { "line-cap": "round", "line-join": "round", "line-sort-key": ["-", 200, ["to-number", ["get", "rank"]]] },
      "paint": { "line-color": ["match", ["get", "rank"], "103", "#ffd25e", "#f6a447"],
                 "line-width": ["interpolate", ["linear"], ["zoom"], 10, 2, 11, 2.4] } },

    { "id": "link-casing", "type": "line", "source": "emap-link", "source-layer": "v_link", "minzoom": 12,
      "filter": ["any", ["!=", ["get", "rank"], "107"], [">=", ["zoom"], 13]],
      "layout": { "line-cap": "round", "line-join": "round", "line-sort-key": ["-", 200, ["to-number", ["get", "rank"]]] },
      "paint": { "line-color": ["match", ["get", "rank"], ["101", "102"], "#c97b26", "103", "#c9a440", "104", "#cdb576", "#c8c1b3"],
                 "line-width": ["interpolate", ["exponential", 1.6], ["zoom"],
                   12, ["match", ["get", "rank"], ["101", "102"], 4, ["103", "104"], 3.4, ["105", "106"], 2.6, 1.2],
                   14, ["match", ["get", "rank"], ["101", "102"], 7, ["103", "104"], 6, ["105", "106"], 4.6, 3.4],
                   16, ["match", ["get", "rank"], ["101", "102"], 13, ["103", "104"], 11, ["105", "106"], 9, 7],
                   18, ["match", ["get", "rank"], ["101", "102"], 28, ["103", "104"], 24, ["105", "106"], 19, 15]] } },
    { "id": "link-fill", "type": "line", "source": "emap-link", "source-layer": "v_link", "minzoom": 12,
      "filter": ["any", ["!=", ["get", "rank"], "107"], [">=", ["zoom"], 13]],
      "layout": { "line-cap": "round", "line-join": "round", "line-sort-key": ["-", 200, ["to-number", ["get", "rank"]]] },
      "paint": { "line-color": ["match", ["get", "rank"], ["101", "102"], "#f6a447", "103", "#ffd25e", "104", "#fff0b0", "#ffffff"],
                 "line-width": ["interpolate", ["exponential", 1.6], ["zoom"],
                   12, ["match", ["get", "rank"], ["101", "102"], 2.6, ["103", "104"], 2.2, ["105", "106"], 1.6, 0.4],
                   14, ["match", ["get", "rank"], ["101", "102"], 5, ["103", "104"], 4.4, ["105", "106"], 3.2, 2.2],
                   16, ["match", ["get", "rank"], ["101", "102"], 10.5, ["103", "104"], 9, ["105", "106"], 7, 5.4],
                   18, ["match", ["get", "rank"], ["101", "102"], 25, ["103", "104"], 21, ["105", "106"], 16.5, 12.5]] } },

    { "id": "rail-casing", "type": "line", "source": "emap-rail", "source-layer": "v_rail2", "minzoom": 12,
      "paint": { "line-color": "#8f8f8f", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 2.2, 15, 4, 18, 6] } },
    { "id": "rail-dash", "type": "line", "source": "emap-rail", "source-layer": "v_rail2", "minzoom": 12,
      "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 15, 2, 18, 3.5], "line-dasharray": [3, 3] } },

    { "id": "subway-casing", "type": "line", "source": "emap-subway", "source-layer": "v_subway", "minzoom": 13,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 13, 4, 16, 6.5, 18, 9] } },
    { "id": "subway-line", "type": "line", "source": "emap-subway", "source-layer": "v_subway", "minzoom": 9,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": ["match", ["get", "name"],
                   "서울1호선", "#0052a4", "서울2호선", "#00a84d", "서울3호선", "#ef7c1c", "서울4호선", "#00a5de",
                   "서울5호선", "#996cac", "서울6호선", "#cd7c2f", "서울7호선", "#747f00", "서울8호선", "#e6186c",
                   "서울9호선", "#bdb092", "경의중앙선", "#77c4a3", "공항철도", "#0090d2", "경춘선", "#0c8e72",
                   "수인분당선", "#fabe00", "신분당선", "#d4003b", "경강선", "#0054a6", "서해선", "#8fc31f",
                   "우이신설선", "#b0ce18", "김포골드라인", "#a17800", "의정부경전철", "#fda600", "용인에버라인", "#509f22",
                   "인천1호선", "#7ca8d5", "인천2호선", "#ed8b00",
                   "부산1호선", "#f06a00", "부산2호선", "#81bf48", "부산3호선", "#bb8c00", "부산4호선", "#217dcb", "부산김해경전철", "#8652a1",
                   "대구1호선", "#d93f5c", "대구2호선", "#00aa80", "대구3호선", "#ffb100",
                   "대전1호선", "#007448", "광주1호선", "#009088", "#888888"],
                 "line-opacity": ["interpolate", ["linear"], ["zoom"], 9, 0.7, 12, 0.9],
                 "line-width": ["interpolate", ["linear"], ["zoom"], 9, 1, 12, 2, 15, 3.5, 18, 5.5] } },

    { "id": "buld-fill", "type": "fill", "source": "emap-buld", "source-layer": "v_buld", "minzoom": 14, "maxzoom": 15,
      "paint": { "fill-color": ["interpolate", ["linear"], ["coalesce", ["get", "floors"], 1], 1, "#e7e2d8", 5, "#ddd7cb", 15, "#d1cabc", 40, "#c3baaa"],
                 "fill-outline-color": "#cbc4b6", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 14, 0.6, 15, 1] } },
    { "id": "buld-3d", "type": "fill-extrusion", "source": "emap-buld", "source-layer": "v_buld", "minzoom": 15,
      "paint": { "fill-extrusion-color": ["interpolate", ["linear"], ["coalesce", ["get", "floors"], 1], 1, "#e7e2d8", 5, "#ddd7cb", 15, "#d1cabc", 40, "#c3baaa"],
                 "fill-extrusion-height": ["*", ["max", ["coalesce", ["get", "floors"], 1], 1], 3],
                 "fill-extrusion-base": 0,
                 "fill-extrusion-opacity": 0.9 } },

    { "id": "link-label", "type": "symbol", "source": "emap-link", "source-layer": "v_link", "minzoom": 13,
      "filter": ["all", ["has", "name"], ["any", ["!=", ["get", "rank"], "107"], [">=", ["zoom"], 15]]],
      "layout": { "symbol-placement": "line", "text-field": ["get", "name"], "text-font": ["Open Sans Regular"],
                  "text-size": ["interpolate", ["linear"], ["zoom"], 13, 10, 16, 12, 19, 14], "text-max-angle": 30, "symbol-spacing": 350 },
      "paint": { "text-color": "#4a4a4a", "text-halo-color": "#ffffff", "text-halo-width": 1.5 } },
    { "id": "link-low-label", "type": "symbol", "source": "emap-link-low", "source-layer": "v_link_low", "minzoom": 10, "maxzoom": 13,
      "filter": ["all", ["has", "name"], ["in", ["get", "rank"], ["literal", ["101", "102", "103"]]]],
      "layout": { "symbol-placement": "line", "text-field": ["get", "name"], "text-font": ["Open Sans Regular"], "text-size": 11, "symbol-spacing": 450 },
      "paint": { "text-color": "#5a4a2e", "text-halo-color": "#ffffff", "text-halo-width": 1.5 } },
    { "id": "buld-label", "type": "symbol", "source": "emap-buld", "source-layer": "v_buld", "minzoom": 16,
      "filter": ["has", "name"],
      "layout": { "text-field": ["get", "name"], "text-font": ["Open Sans Regular"], "text-size": 11, "text-max-width": 8 },
      "paint": { "text-color": "#6b6355", "text-halo-color": "#ffffff", "text-halo-width": 1 } },
    { "id": "station", "type": "circle", "source": "emap-station", "source-layer": "v_station", "minzoom": 12,
      "paint": { "circle-radius": ["interpolate", ["linear"], ["zoom"], 12, 3, 16, 6], "circle-color": "#ffffff",
                 "circle-stroke-color": "#4d4d4d", "circle-stroke-width": ["interpolate", ["linear"], ["zoom"], 12, 1.2, 16, 2] } },
    { "id": "station-label", "type": "symbol", "source": "emap-station", "source-layer": "v_station", "minzoom": 13,
      "layout": { "text-field": ["get", "name"], "text-font": ["Open Sans Regular"], "text-size": 12,
                  "text-offset": [0, 1.1], "text-anchor": "top" },
      "paint": { "text-color": "#333333", "text-halo-color": "#ffffff", "text-halo-width": 1.5 } },
    { "id": "emd-label", "type": "symbol", "source": "emap-emd", "source-layer": "v_emd", "minzoom": 11, "maxzoom": 15,
      "layout": { "text-field": ["get", "name"], "text-font": ["Open Sans Regular"], "text-size": 12 },
      "paint": { "text-color": "#777777", "text-halo-color": "#f5f3ee", "text-halo-width": 1.5 } },
    { "id": "sig-label", "type": "symbol", "source": "emap-sig", "source-layer": "v_sig", "minzoom": 7, "maxzoom": 12,
      "layout": { "text-field": ["get", "name"], "text-font": ["Open Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 7, 11, 11, 15] },
      "paint": { "text-color": "#444444", "text-halo-color": "#f5f3ee", "text-halo-width": 1.5 } }
  ]
}
