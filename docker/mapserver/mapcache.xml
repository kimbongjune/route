<?xml version="1.0" encoding="UTF-8"?>
<!-- MapServer 벡터 타일을 /var/cache/mapcache에 캐시한다. 주소는 /mapcache/gmaps/{레이어}@GoogleMapsCompatible/{z}/{x}/{y}.pbf -->
<mapcache>
  <format name="mvt" type="RAW"><extension>pbf</extension><mime_type>application/vnd.mapbox-vector-tile</mime_type></format>
  <cache name="disk" type="disk"><base>/var/cache/mapcache</base></cache>
  <source name="v_buld" type="wms"><getmap><params><FORMAT>application/vnd.mapbox-vector-tile</FORMAT><LAYERS>v_buld</LAYERS></params></getmap>
    <http><url>http://localhost/mapserver/?map=/etc/mapserver/emap.map&amp;</url></http></source>
  <tileset name="v_buld"><source>v_buld</source><cache>disk</cache><grid>GoogleMapsCompatible</grid><format>mvt</format><metatile>1 1</metatile><metabuffer>0</metabuffer><expires>86400</expires></tileset>
